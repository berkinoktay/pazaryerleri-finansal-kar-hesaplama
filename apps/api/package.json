{
  "name": "@pazarsync/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "start": "tsx src/index.ts",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:integration:rls": "vitest run --config vitest.rls.config.ts --passWithNoTests",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts",
    "audit:stored-workbooks": "tsx --env-file-if-exists=../../.env scripts/audit-stored-workbooks.ts",
    "gen:encryption-key": "tsx scripts/gen-encryption-key.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@pazarsync/catalog-sync": "workspace:*",
    "@pazarsync/spreadsheet": "workspace:*",
    "@pazarsync/db": "workspace:*",
    "@pazarsync/marketplace": "workspace:*",
    "@pazarsync/order-sync": "workspace:*",
    "@pazarsync/profit": "workspace:*",
    "@pazarsync/sync-core": "workspace:*",
    "@pazarsync/utils": "workspace:*",
    "@pazarsync/webhook-ingest": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.14",
    "@supabase/supabase-js": "catalog:",
    "decimal.js": "catalog:",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pazarsync/eslint-config": "workspace:*",
    "@pazarsync/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "tsup": "^8.4.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
